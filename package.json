{
  "name": "TokenSavingsRN",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint App.tsx src __tests__ --max-warnings 0",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "benchmark": "npm --prefix benchmarks run bench",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output benchmarks/artifacts/main.jsbundle --assets-dest benchmarks/artifacts/assets",
    "check": "node benchmarks/scripts/check-app.mjs",
    "bench:doctor": "npm --prefix benchmarks run doctor",
    "bench:verify": "npm --prefix benchmarks run verify:snapshot",
    "bench:all": "npm --prefix benchmarks run bench:all",
    "native:pods": "node benchmarks/scripts/native-check.mjs pods",
    "native:ios": "node benchmarks/scripts/native-check.mjs ios",
    "native:android": "node benchmarks/scripts/native-check.mjs android",
    "native:metro": "node benchmarks/scripts/native-check.mjs metro"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.5.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-worklets": "0.13.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
